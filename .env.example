# Copy to .env and replace the bot token. Never commit .env.
DISCORD_TOKEN=replace-with-your-bot-token

# Optional: enables the full Steam Store name catalog. Never enter this key in Discord.
# AppIDs, Steam links, and names already learned from Steam work without it.
STEAM_WEB_API_KEY=

# Optional settings (minimums: 30 seconds for builds, 60 seconds for news).
BUILD_INTERVAL_SECONDS=60
NEWS_INTERVAL_SECONDS=300
RUST_LOG=vaporator=info,warn

# Used by local cargo runs. Docker Compose always uses /data.
DATA_DIR=data
